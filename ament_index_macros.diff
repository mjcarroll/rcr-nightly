+def ament_index_env(env = None):
+    """Adds the plugin that lets ament_index_python find the ament index in the runfiles.
+
+    Python tests have no AMENT_PREFIX_PATH; the Bazel provider in ament_index_python registers
+    the runfiles root as a prefix when it holds an ament index (see ament_index.bzl). The variable
+    is inherited by child processes, such as nodes started by launch.
+
+    Args:
+      env: The test's own env dict, if any.
+
+    Returns:
+      A new env dict that includes the plugin.
+    """
+    merged = dict(env or {})
+    plugins = [p for p in merged.get("AMENT_INDEX_PYTHON_PLUGINS", "").split(",") if p]
+    if "ament_index_python._bazel" not in plugins:
+        plugins.append("ament_index_python._bazel")
+    merged["AMENT_INDEX_PYTHON_PLUGINS"] = ",".join(plugins)
+    return merged
+
