load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:defs.bzl", "RMW", "comm_launch_tests")

package(default_visibility = ["//visibility:public"])

exports_files(["package.xml", "run_with_arg.sh"])

# rosidl_generate_interfaces(${PROJECT_NAME} msg/*.msg DEPENDENCIES test_msgs SKIP_INSTALL)
default_generators(
    dependencies = ["@test_msgs"],
    package_xml = "package.xml",
    deps = [
        "//msg:FieldsWithSameType",
        "//msg:Inner",
        "//msg:Outer",
        "//msg:UInt32",
    ],
)

# The interfaces of test_msgs (ament_index_get_resource(rosidl_interfaces test_msgs))
MESSAGE_TYPES = [
    "Arrays",
    "BasicTypes",
    "BoundedPlainSequences",
    "BoundedSequences",
    "Builtins",
    "ComplexNestedKey",
    "Constants",
    "Defaults",
    "Empty",
    "KeyedLong",
    "KeyedString",
    "MultiNested",
    "Nested",
    "NonKeyedWithNestedKey",
    "Strings",
    "UnboundedSequences",
    "WStrings",
]

SERVICE_TYPES = ["Arrays", "BasicTypes", "Empty"]

ACTION_TYPES = ["Fibonacci", "NestedMessage"]

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosidl_typesupport_c//:rosidl_typesupport_c": "@rosidl_typesupport_c//:rosidl_typesupport_c_library",
    "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp": "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp_library",
    "@test_msgs//:cc_shared": "@test_msgs//:test_msgs_cc",
    ":cc_shared": ":cc",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

INDEX = [":ament_index", "@test_msgs//:ament_index"]

cc_library(
    name = "subscribe_types",
    srcs = [
        "test/subscribe_array_types.cpp",
        "test/subscribe_basic_types.cpp",
        "test/subscribe_helper.hpp",
        "test/subscribe_key_types.cpp",
        "test/subscribe_string_types.cpp",
    ],
    hdrs = [
        "test/subscribe_array_types.hpp",
        "test/subscribe_basic_types.hpp",
        "test/subscribe_key_types.hpp",
        "test/subscribe_string_types.hpp",
    ],
    includes = ["test"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

# custom_executable()
[
    cc_binary(
        name = name,
        srcs = ["test/{}.cpp".format(src)],
        data = INDEX,
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + [":subscribe_types"],
    )
    for name, src in {
        "test_publisher_subscriber_cpp": "test_publisher_subscriber",
        "test_subscription_valid_data_cpp": "test_subscription_valid_data",
        "test_publisher_cpp": "test_publisher",
        "test_subscriber_cpp": "test_subscriber",
        "test_requester_cpp": "test_requester",
        "test_replier_cpp": "test_replier",
        "test_action_client_cpp": "test_action_client",
        "test_action_server_cpp": "test_action_server",
        "test_nested_types": "test_nested_types",
    }.items()
]

# custom_test(<exe> TRUE): one run per message type
[
    sh_test(
        name = "test_publisher_subscriber_cpp__" + msg,
        srcs = ["//:run_with_arg.sh"],
        args = ["$(rootpath :test_publisher_subscriber_cpp)", msg],
        data = [":test_publisher_subscriber_cpp"] + INDEX,
        env = {
            "RCL_ASSERT_RMW_ID_MATCHES": RMW,
            "RMW_IMPLEMENTATION": RMW,
        },
        timeout = "short",
    )
    for msg in MESSAGE_TYPES
]

# custom_test(<exe> FALSE)
[
    sh_test(
        name = exe + "_run",
        srcs = ["//:run_with_arg.sh"],
        args = ["$(rootpath :{})".format(exe)],
        data = [":" + exe] + INDEX,
        env = {
            "RCL_ASSERT_RMW_ID_MATCHES": RMW,
            "RMW_IMPLEMENTATION": RMW,
        },
        timeout = "short",
    )
    for exe in [
        "test_subscription_valid_data_cpp",
        "test_nested_types",
    ]
]

# custom_test_c + serialize + pub_sub_serialized gtests
cc_test(
    name = "test_messages_c",
    timeout = "long",
    srcs = ["test/test_messages_c.cpp"],
    data = INDEX,
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@osrf_testing_tools_cpp//:memory_tools_interpose",
    ],
    env = {
        "RCL_ASSERT_RMW_ID_MATCHES": RMW,
        "RMW_IMPLEMENTATION": RMW,
    },
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
    ],
)

[
    cc_test(
        name = name,
        timeout = "moderate",
        srcs = ["test/{}.cpp".format(src)],
        data = INDEX,
        dynamic_deps = [":transitive_dynamic_deps"],
        env = {
            "RCL_ASSERT_RMW_ID_MATCHES": RMW,
            "RMW_IMPLEMENTATION": RMW,
        },
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + ["@rosdistro//cc:googletest"],
    )
    for name, src in {
        "test_serialize": "test_message_serialization",
        "test_publisher_subscriber_serialized": "test_publisher_subscriber_serialized",
    }.items()
]

# launch tests: publisher/subscriber, requester/replier, action client/server
# for every (client library 1, client library 2) pair
PY_DEPS = [
    "@rclpy//:rclpy",
    "@test_msgs//:py",
    "@test_msgs//:test_msgs_py",
    ":py",
]

CPP = {
    "publisher": ":test_publisher_cpp",
    "subscriber": ":test_subscriber_cpp",
    "requester": ":test_requester_cpp",
    "replier": ":test_replier_cpp",
    "action_client": ":test_action_client_cpp",
    "action_server": ":test_action_server_cpp",
}

PY = {
    "publisher": "test/publisher_py.py",
    "subscriber": "test/subscriber_py.py",
    "requester": "test/requester_py.py",
    "replier": "test/replier_py.py",
    "action_client": "test/action_client_py.py",
    "action_server": "test/action_server_py.py",
}

comm_launch_tests(
    cpp = CPP,
    data = INDEX,
    message_types = MESSAGE_TYPES,
    py = PY,
    py_deps = PY_DEPS,
    action_types = ACTION_TYPES,
    service_types = SERVICE_TYPES,
)
