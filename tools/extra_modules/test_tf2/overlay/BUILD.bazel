load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(["package.xml"])

# name -> (shared library target, its cc_library) for everything the tests link.
DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_bullet//:tf2_bullet": "@tf2_bullet//:tf2_bullet_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_kdl//:tf2_kdl": "@tf2_kdl//:tf2_kdl_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = ["@tf2_ros//:ament_index"],
)

# ament_add_ros_isolated_gtest / ament_add_gtest
[
    cc_test(
        name = name,
        timeout = "moderate",
        srcs = [src] + extra_srcs,
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + ["@rosdistro//cc:googletest"],
    )
    for name, src, extra_srcs in [
        ("buffer_core_test", "test/buffer_core_test.cpp", ["test/permuter.hpp"]),
        ("test_message_filter", "test/test_message_filter.cpp", []),
        ("test_convert", "test/test_convert.cpp", []),
        ("test_utils", "test/test_utils.cpp", []),
        ("test_tf2_bullet", "test/test_tf2_bullet.cpp", []),
    ]
]

# add_executable(): the nodes the launch tests start
[
    cc_binary(
        name = name,
        srcs = ["test/{}.cpp".format(name), "test/permuter.hpp"],
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + ["@rosdistro//cc:googletest"],
    )
    for name in [
        "test_buffer_server",
        "test_buffer_client",
        "test_static_publisher",
    ]
]

# add_launch_test()
[
    launch_ros_test(
        name = "{}_launch_py".format(name),
        src = "test/{}.launch.py".format(name),
        data = [":ament_index"],
        deps = [
            ":test_buffer_client",
            ":test_buffer_server",
            ":test_static_publisher",
            "@tf2_ros//:static_transform_publisher",
            "@tf2_ros_py//:tf2_ros_py",
        ],
    )
    for name in [
        "buffer_client_tester",
        "static_publisher",
    ]
]
