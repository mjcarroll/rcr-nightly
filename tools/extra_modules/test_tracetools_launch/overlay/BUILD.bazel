load("@rosdistro//python:defs.bzl", "py_pytest")

package(default_visibility = ["//visibility:public"])

exports_files(["package.xml"])

# ament_add_pytest_test over test/ (linters/mypy skipped)
[
    py_pytest(
        name = src.removeprefix("test/test_tracetools_launch/").removesuffix(".py"),
        timeout = "moderate",
        # lttng-sessiond's socket lives under $LTTNG_HOME/.lttng; the sandbox HOME exceeds sun_path (108 bytes)
        env = {"LTTNG_HOME": "/tmp"},
        srcs = [src],
        data = [
            "@test_tracetools//:ament_index",
            "@test_tracetools//:libexec",
        ],
        deps = [
            "@launch//:launch",
            "@launch_ros//:launch_ros",
            "@launch_testing_ros//:launch_testing_ros",
            "@launch_xml//:launch_xml",
            "@launch_yaml//:launch_yaml",
            "@tracetools_launch//:tracetools_launch",
            "@tracetools_trace//:tracetools_trace",
        ],
    )
    for src in glob(["test/test_tracetools_launch/test_*.py"])
]
