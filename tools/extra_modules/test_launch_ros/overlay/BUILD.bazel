load("//:libexec.bzl", "libexec_layout")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(default_visibility = ["//visibility:public"])

exports_files(["package.xml"])

# The nodes the tests launch by package/executable name.
ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@composition//:ament_package",
        "@demo_nodes_py//:ament_package",
        "@launch_ros//:ament_package",
        "@lifecycle//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)

# python packages only get console_scripts in bin/, not lib/<pkg>/ as launch_ros expects
libexec_layout(
    name = "libexec",
    executables = {
        "@demo_nodes_py//:listener_qos": "demo_nodes_py",
        "@demo_nodes_py//:talker_qos": "demo_nodes_py",
    },
)

PYTHON_DEPS = [
    "@builtin_interfaces//:py",
    "@composition_interfaces//:py",
    "@launch//:launch",
    "@launch_ros//:launch_ros",
    "@launch_xml//:launch_xml",
    "@launch_yaml//:launch_yaml",
    "@lifecycle_msgs//:py",
    "@osrf_pycommon//:osrf_pycommon",
    "@rclpy//:rclpy",
    "@rmw_test_fixture_implementation//:rmw_test_fixture_implementation_py",
    "@rosgraph_msgs//:py",
    requirement("pyyaml"),
]

TEST_DATA = [
    "conftest.py",
    "pytest.ini",
    ":ament_index",
    ":libexec",
] + glob(["test/**/*.yaml"])

# ament_add_pytest_test over test/ (the linter tests are skipped: ament_lint is covered by
# the launch_ros module itself): one target per test file.
[
    py_pytest(
        name = src.removeprefix("test/test_launch_ros/").removesuffix(".py").replace("/", "__"),
        timeout = "moderate",
        srcs = [src],
        data = TEST_DATA,
        deps = PYTHON_DEPS,
    )
    for src in glob(["test/test_launch_ros/**/test_*.py"])
]
