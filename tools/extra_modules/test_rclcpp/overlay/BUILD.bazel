load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:defs.bzl", "RMW", "configured_launch_test", "rl")

package(default_visibility = ["//visibility:public"])

exports_files(["package.xml"])

# rosidl_generate_interfaces(${PROJECT_NAME} msg/UInt32.msg srv/AddTwoInts.srv SKIP_INSTALL)
default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:UInt32",
        "//srv:AddTwoInts",
    ],
)

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    ":cc_shared": ":cc",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# :ament_index is generated by default_generators; the tests also read rcl_interfaces' index
INDEX = [":ament_index", "@rcl_interfaces//:ament_index"]

cc_library(
    name = "test_rclcpp_headers",
    hdrs = glob(["include/test_rclcpp/*.hpp"]),
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

# ament_add_gtest_executable + ament_add_ros_isolated_gtest_test, per RMW
# name -> (source, timeout)
GTESTS = {
    "gtest_avoid_ros_namespace_conventions_qos": ("test_avoid_ros_namespace_conventions_qos", "short"),
    "gtest_publisher": ("test_publisher", "short"),
    "gtest_client_wait_for_service_shutdown": ("test_client_wait_for_service_shutdown", "moderate"),
    "gtest_executor": ("test_executor", "moderate"),
    "gtest_repeated_publisher_subscriber": ("test_repeated_publisher_subscriber", "short"),
    "gtest_spin": ("test_spin", "moderate"),
    "gtest_subscription": ("test_subscription", "moderate"),
    "gtest_multiple_service_calls": ("test_multiple_service_calls", "moderate"),
    "gtest_timer": ("test_timer", "moderate"),
    "gtest_timeout_subscriber": ("test_timeout_subscriber", "moderate"),
    "gtest_intra_process": ("test_intra_process", "short"),
    "gtest_multithreaded": ("test_multithreaded", "moderate"),
    "gtest_local_parameters": ("test_local_parameters", "long"),
    "gtest_services_in_constructor": ("test_services_in_constructor", "moderate"),
    "gtest_waitable": ("test_waitable", "long"),
}

[
    cc_test(
        name = name,
        timeout = timeout,
        srcs = ["test/{}.cpp".format(src)] + glob(["test/*.hpp"]),
        data = INDEX,
        dynamic_deps = [":transitive_dynamic_deps"],
        env = {"RMW_IMPLEMENTATION": RMW},
        local_defines = ros_local_defines(),
        deps = [":test_rclcpp_headers", "@rosdistro//cc:googletest"],
    )
    for name, (src, timeout) in GTESTS.items()
]

# helper executables (add_executable / ament_add_gtest_executable)
[
    cc_binary(
        name = name,
        srcs = ["test/{}.cpp".format(src)] + glob(["test/*.hpp"]),
        data = INDEX,
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = [":test_rclcpp_headers", "@rosdistro//cc:googletest"],
    )
    for name, src in {
        "node_with_name": "node_with_name",
        "node_name_list": "node_name_list",
        "node_check_names": "node_check_names",
        "test_sigint_handler": "test_sigint_handler",
        "test_sigterm_handler": "test_sigterm_handler",
        "test_parameters_server_cpp": "test_parameters_server",
        "test_remote_parameters_cpp": "test_remote_parameters",
        "test_services_server_cpp": "test_services_server",
        "test_services_client_cpp": "test_services_client",
        "test_client_scope_server_cpp": "test_client_scope_server",
        "test_client_scope_client_cpp": "test_client_scope_client",
        "test_client_scope_consistency_server_cpp": "test_client_scope_consistency_server",
        "test_client_scope_consistency_client_cpp": "test_client_scope_consistency_client",
    }.items()
]

# custom_launch_test_two_executables()
[
    configured_launch_test(
        name = name,
        template = "test/test_two_executables.py.in",
        exes = [":" + exe1, ":" + exe2],
        data = INDEX,
        substitutions = {
            "TEST_NAME": name,
            "TEST_EXECUTABLE1": rl(":" + exe1),
            "TEST_EXECUTABLE1_ARGS": args1,
            "TEST_EXECUTABLE1_NAME": exe1,
            "TEST_RMW_IMPLEMENTATION1": RMW,
            "TEST_EXECUTABLE2": rl(":" + exe2),
            "TEST_EXECUTABLE2_ARGS": args2,
            "TEST_EXECUTABLE2_NAME": exe2,
            "TEST_RMW_IMPLEMENTATION2": RMW,
        },
        timeout = "moderate",
        env = {"RMW_IMPLEMENTATION": RMW},
    )
    for name, exe1, exe2, args1, args2 in [
        ("test_parameter_server_cpp", "test_parameters_server_cpp", "test_remote_parameters_cpp", "", ""),
        ("test_services_cpp", "test_services_server_cpp", "test_services_client_cpp", "", ""),
        ("test_client_scope_cpp", "test_client_scope_server_cpp", "test_client_scope_client_cpp", "", ""),
        ("test_client_scope_consistency_cpp", "test_client_scope_consistency_server_cpp", "test_client_scope_consistency_client_cpp", "", ""),
        ("test_node_name", "node_with_name", "node_name_list", RMW, "node_with_name_" + RMW),
    ]
]

# custom_launch_n_nodes(10)
configured_launch_test(
    name = "test_n_nodes",
    template = "test/test_n_nodes.py.in",
    exes = [":node_with_name", ":node_check_names"],
    data = INDEX,
    substitutions = {
        "TEST_EXECUTABLE1": rl(":node_with_name"),
        "TEST_EXECUTABLE2": rl(":node_check_names"),
        "TEST_RMW_IMPLEMENTATION": RMW,
        "TEST_NUM_NODES": "10",
    },
    timeout = "short",
    env = {"RMW_IMPLEMENTATION": RMW},
)

# custom_launch_test_executable_output()
[
    configured_launch_test(
        name = name,
        template = "test/{}.py.in".format(template),
        exes = [":" + exe],
        files = [
            "test/expected_outputs/{}__trigger_shutdown.txt".format(name),
            "test/expected_outputs/{}__expected_output.txt".format(name),
        ],
        data = INDEX,
        substitutions = {
            "TEST_NAME": name,
            "TEST_EXECUTABLE": rl(":" + exe),
            "TEST_EXECUTABLE_NAME": exe,
            "TEST_EXECUTABLE_TRIGGER_SHUTDOWN_OUTPUT": rl("test/expected_outputs/{}__trigger_shutdown.txt".format(name)),
            "TEST_EXECUTABLE_EXPECTED_OUTPUT": rl("test/expected_outputs/{}__expected_output.txt".format(name)),
            "rmw_implementation": RMW,
        },
        timeout = "moderate",
        env = {"RMW_IMPLEMENTATION": RMW},
    )
    for name, exe, template in [
        ("test_sigint_handler_before_shutdown", "test_sigint_handler", "test_executable_output"),
        ("test_sigint_handler_after_shutdown", "test_sigint_handler", "test_executable_output"),
        ("test_sigterm_handler_before_shutdown", "test_sigterm_handler", "test_sigterm"),
        ("test_sigterm_handler_after_shutdown", "test_sigterm_handler", "test_sigterm"),
    ]
]
