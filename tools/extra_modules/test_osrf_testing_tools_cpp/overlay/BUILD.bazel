load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# osrf_testing_tools_cpp_add_test() with the memory_tools interposer active (LD_PRELOAD in CMake)
cc_test(
    name = "test_example_memory_tools",
    srcs = ["test/test_example_memory_tools.cpp"],
    dynamic_deps = ["@osrf_testing_tools_cpp//:memory_tools_interpose"],
    deps = [
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
    ],
)

# ...and without it: the test asserts is_working() is false when the interposer is not loaded.
# KNOWN GAP: the registry's osrf_testing_tools_cpp//:memory_tools_shared bundles the interposing
# core (unlike upstream's libmemory_tools), so is_working() is always true. Needs a registry fix.
cc_test(
    name = "test_is_not_working",
    tags = ["manual"],
    srcs = ["test/test_is_not_working.cpp"],
    dynamic_deps = ["@osrf_testing_tools_cpp//:memory_tools_shared"],
    deps = [
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
    ],
)
