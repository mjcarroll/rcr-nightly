load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "LICENSE",
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

py_library(
    name = "ros2log",
    srcs = glob(["ros2log/**/*.py"]),
    data = ["ros2log/py.typed"] + [":ament_index"],
    imports = ["."],
    deps = [
        "@rcl_interfaces//:py",
        "@rclpy//:rclpy",
        "@ros2cli//:ros2cli",
        "@ros2node//:ros2node",
        "@rosgraph_msgs//:py",
    ],
)

[
    py_pytest(
        name = test,
        srcs = ["test/{}.py".format(test)],
        data = glob(["test/fixtures/*.py"]),
        # the CLI tests run `ros2 ...` as a subprocess, which is not runnable here yet
        # (same status as ros2node's test_cli)
        tags = ["manual", "xfail"] if test == "test_cli" else [],
        deps = [
            ":ros2log",
            "@launch//:launch",
            "@launch_ros//:launch_ros",
            "@launch_testing//:launch_testing",
            "@launch_testing_ros//:launch_testing_ros",
            "@rclpy//:rclpy",
            "@ros2cli//:ros2cli",
            "@test_msgs//:py",
        ],
    )
    for test in [
        "test_api",
        "test_cli",
        "test_get",
        "test_levels",
        "test_set",
        "test_watch",
    ]
]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2log"] + ["ros2log/py.typed"],
    deps = [
        ":ament_index",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2node//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
