load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# rosidl_generate_interfaces(${PROJECT_NAME} <all test_interface_files msg/srv/action> SKIP_INSTALL)
default_generators(
    package_xml = "package.xml",
    deps = [
        "//action:Fibonacci",
        "//msg:Arrays",
        "//msg:BasicTypes",
        "//msg:BoundedPlainSequences",
        "//msg:BoundedSequences",
        "//msg:Constants",
        "//msg:Defaults",
        "//msg:Empty",
        "//msg:MultiNested",
        "//msg:Nested",
        "//msg:Strings",
        "//msg:UnboundedSequences",
        "//msg:WStrings",
        "//srv:Arrays",
        "//srv:BasicTypes",
        "//srv:Empty",
    ],
)

DEPENDENCIES = {
    "@action_msgs//:cc_shared": "@action_msgs//:cc",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rmw_implementation//:rmw_implementation": "@rmw_implementation//:rmw_implementation_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@rosidl_typesupport_c//:rosidl_typesupport_c": "@rosidl_typesupport_c//:rosidl_typesupport_c_library",
    "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp": "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp_library",
    "@service_msgs//:cc_shared": "@service_msgs//:cc",
    ":cc_shared": ":cc",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = "test_service_typesupport_" + lang,
        srcs = ["test/rosidl_typesupport_{}/test_service_typesupport.cpp".format(lang)],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + ["@rosdistro//cc:googletest"],
    )
    for lang in ["c", "cpp"]
]
