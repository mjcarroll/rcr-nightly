load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# helper programs the tests launch (found relative to the working directory)
cc_binary(
    name = "locking",
    srcs = ["test/dummy_tests/locking.cpp"],
    deps = ["@rosdistro//cc:googletest"],
)

cc_binary(
    name = "dummy",
    srcs = ["test/dummy_tests/dummy.cpp"],
    deps = ["@rosdistro//cc:googletest"],
)

PYTHON_DEPS = [
    "@launch//:launch",
    "@launch_testing//:launch_testing",
    requirement("pytest"),
]

# ament_add_pytest_test(test_pytest_py ... WORKING_DIRECTORY test/dummy_tests)
py_test(
    name = "test_pytest_py",
    srcs = ["chdir_pytest_main.py"],
    args = [
        "test/dummy_tests",
        "$(location test/test_launch_testing/actions/test_pytest.py)",
    ],
    data = [
        "test/dummy_tests/dummy.py",
        "test/dummy_tests/locking.py",
        "test/test_launch_testing/actions/test_pytest.py",
    ],
    main = "chdir_pytest_main.py",
    deps = PYTHON_DEPS,
)

# ament_add_pytest_test(test_gtest_py ... WORKING_DIRECTORY <build dir with locking & dummy>)
py_test(
    name = "test_gtest_py",
    srcs = ["chdir_pytest_main.py"],
    args = [
        ".",
        "$(location test/test_launch_testing/actions/test_gtest.py)",
    ],
    data = [
        ":dummy",
        ":locking",
        "test/test_launch_testing/actions/test_gtest.py",
    ],
    main = "chdir_pytest_main.py",
    deps = PYTHON_DEPS,
)
