+// Providers cannot be unregistered, so the test provider only contributes while the environment
+// variable below is set.
+static void ensure_test_provider_registered()
+{
+  static bool registered = false;
+  if (registered) {
+    return;
+  }
+  registered = true;
+  ament_index_cpp::register_search_path_provider(
+    []() -> std::list<std::filesystem::path> {
+      const char * extra = getenv("AMENT_INDEX_TEST_PROVIDER_PREFIX");
+      if (!extra) {
+        return {};
+      }
+      return {generate_subfolder_path(extra)};
+    });
+}
+
+TEST(AmentIndexCpp, search_path_provider_only) {
+  ensure_test_provider_registered();
+  set_ament_prefix_path({});
+  setenv("AMENT_INDEX_TEST_PROVIDER_PREFIX", "prefix1", 1);
+  auto search_paths = ament_index_cpp::get_searcheable_paths();
+  unsetenv("AMENT_INDEX_TEST_PROVIDER_PREFIX");
+  ASSERT_EQ(search_paths.size(), 1UL);
+  EXPECT_EQ(search_paths.front(), generate_subfolder_path("prefix1"));
+}
+
+TEST(AmentIndexCpp, search_path_provider_after_environment) {
+  ensure_test_provider_registered();
+  set_ament_prefix_path({"prefix2"});
+  setenv("AMENT_INDEX_TEST_PROVIDER_PREFIX", "prefix1", 1);
+  auto search_paths = ament_index_cpp::get_searcheable_paths();
+  unsetenv("AMENT_INDEX_TEST_PROVIDER_PREFIX");
+  ASSERT_EQ(search_paths.size(), 2UL);
+  EXPECT_EQ(search_paths.front(), generate_subfolder_path("prefix2"));
+  EXPECT_EQ(search_paths.back(), generate_subfolder_path("prefix1"));
+}
+
+TEST(AmentIndexCpp, search_path_provider_not_existing_still_throws) {
+  ensure_test_provider_registered();
+  set_ament_prefix_path({});
+  setenv("AMENT_INDEX_TEST_PROVIDER_PREFIX", "not_existing_prefix", 1);
+  EXPECT_THROW(ament_index_cpp::get_searcheable_paths(), std::runtime_error);
+  unsetenv("AMENT_INDEX_TEST_PROVIDER_PREFIX");
+}
