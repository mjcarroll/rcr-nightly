+/// A function returning additional ament prefixes to search.
+using SearchPathProvider = std::function<std::list<std::filesystem::path>()>;
+
+/// Register a provider of additional search paths.
+/**
+ * Providers are queried by get_searcheable_paths() after the entries of AMENT_PREFIX_PATH, so that
+ * environments without an installed prefix (for example a build system that runs tests from a
+ * runfiles tree) can supply one. Non-directories are skipped, like entries of AMENT_PREFIX_PATH.
+ * With no providers registered, behavior is unchanged.
+ * Registration is thread-safe. Providers cannot be unregistered.
+ */
+AMENT_INDEX_CPP_PUBLIC
+void
+register_search_path_provider(SearchPathProvider provider);
+
 }  // namespace ament_index_cpp
 
 #endif  // AMENT_INDEX_CPP__GET_SEARCH_PATHS_HPP_
