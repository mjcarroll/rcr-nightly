+from typing import Callable, List
 
 from .constants import AMENT_PREFIX_PATH_ENV_VAR
 
 
+# Comma separated module names, imported on first use. A module registers itself on import with
+# register_search_path_provider(). This is how an environment without an installed prefix (for
+# example Bazel runfiles) plugs in for every Python process, including child processes.
+AMENT_INDEX_PLUGINS_ENV_VAR = 'AMENT_INDEX_PYTHON_PLUGINS'
+
+_providers: List[Callable[[], List[str]]] = []
+_plugins_loaded = set()
+
+
+def register_search_path_provider(provider: Callable[[], List[str]]) -> None:
+    """
+    Register a function returning additional ament prefixes to search.
+
+    Providers are queried by :func:`get_search_paths` after the entries of
+    'AMENT_PREFIX_PATH'. With no providers registered, behavior is unchanged.
+    """
+    _providers.append(provider)
+
+
+def _load_plugins() -> None:
+    for name in os.environ.get(AMENT_INDEX_PLUGINS_ENV_VAR, '').split(','):
+        name = name.strip()
+        if name and name not in _plugins_loaded:
+            _plugins_loaded.add(name)
+            importlib.import_module(name)
+
+
 def get_search_paths() -> List[str]:
     """
-    Get the paths from the environment variable 'AMENT_PREFIX_PATH'.
+    Get the paths from the environment variable 'AMENT_PREFIX_PATH' and registered providers.
 
